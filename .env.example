# Get a free API key at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# Email (Gmail example - use an App Password, not your real password)
# https://support.google.com/accounts/answer/185833
EMAIL_FROM=youraddress@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_TO=recipient@example.com;another@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Schedule (24h clock, in TIMEZONE)
RUN_TIME=07:00
TIMEZONE=US/Eastern

# Saving
SAVE_CSV=true
CSV_DIR=./reports
